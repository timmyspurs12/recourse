{
  "name": "recourse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/prestart.mjs && next start",
    "lint": "eslint",
    "seed": "tsx server/seed.ts",
    "seed:fast": "tsx server/seed.ts --fast",
    "test": "tsx --test tests/lifecycle.test.ts tests/security.test.ts tests/auth.test.ts tests/genlayer.test.ts",
    "test:live": "RECOURSE_LIVE=1 tsx --test --test-timeout=600000 tests/genlayer.live.test.ts",
    "genlayer:deploy": "tsx scripts/genlayer-deploy.mts",
    "genlayer:smoke": "tsx scripts/genlayer-smoke.mts",
    "agents": "tsx server/agents.ts",
    "agents:register": "tsx server/agents.ts register",
    "wallet": "node scripts/new-wallet.mjs"
  },
  "dependencies": {
    "@genlayer/transaction-kit": "0.1.0-rc.2",
    "genlayer-js": "2.0.0-rc.1",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "^2.56.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
