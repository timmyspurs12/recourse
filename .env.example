# Recourse — environment template.
#
# Everything has a working default; set these only to change where it points.
# Copy to `.env.local` for local development (Next.js loads that file), or set
# them as service variables on your host.

# ---------------------------------------------------------------- adjudication
# Studio Next (Consensus v0.6, chain 61997) is the default and the network the
# hackathon requires. Other options: studio-dev, studionet, testnet-asimov,
# testnet-bradbury, localnet.
GENLAYER_NETWORK=studio-next

# Written by `npm run genlayer:deploy`. Until this is set, the app reports
# adjudication as unavailable rather than pretending to rule.
GENLAYER_CONTRACT_ADDRESS=

# Every deploy and write on a fee-charging network escrows a fee deposit from
# this key. On Studio Next an ephemeral account is topped up by the sandbox
# (`sim_fundAccount`); on a public testnet fund it from the faucet.
GENLAYER_PRIVATE_KEY=

# Measured fee profile consumed by the transaction kit. Must declare
# chainId=61997 to be applied; a profile measured on another chain is ignored
# with an explanation rather than silently mis-pricing the deposit.
# RECOURSE_FEE_PROFILE=/app/fee-profile.json

# --------------------------------------------------------------- protocol mode
# 1 = mutating endpoints require a signed agent request (default).
RECOURSE_REQUIRE_AUTH=1
# 0 = refuse handles that were not pre-registered.
RECOURSE_STRICT_REGISTRY=0
# 0 = disable the keyless demo endpoints (they act as the protocol itself).
RECOURSE_DEMO_ENDPOINTS=1

# -------------------------------------------------------------------- storage
RECOURSE_STORE_FILE=/app/.recourse/ledger.json

# ---------------------------------------------------------------------- rail
# x402 or simulated.
RECOURSE_RAIL=x402
# Set only when you control a funded facilitator; settlement is otherwise
# recorded as signature-verified with a null transaction hash.
# X402_FACILITATOR_URL=
